		clue_text = str(site.get("clue", "去大世界寻找新的顾客。"))
	var clue := _create_business_label(clue_text, 12, Color(0.31, 0.31, 0.24), 24.0, true)
	clue.custom_minimum_size = Vector2(142.0, 94.0)
