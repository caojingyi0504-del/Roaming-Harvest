	pop.position = Vector3(center.x, _height_at(center.x, center.y) + 0.62, center.y)
	var quality_scale := _crop_quality_scale(quality)
	pop.scale = Vector3.ONE * 0.72 * quality_scale
	_mark_generated(pop)
	add_child(pop)
