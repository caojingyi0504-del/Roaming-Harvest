	detail.add_theme_stylebox_override("panel", _make_round_style(Color(1.0, 0.95, 0.79, 0.99), Color(0.53, 0.34, 0.13, 0.98), 7.0, 2))
	_post_tutorial_objective.add_child(detail)

	var margin := MarginContainer.new()
