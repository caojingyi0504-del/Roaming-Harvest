	for i in range(520):
		var point := Vector2.ZERO
		for retry in range(10):
			if clusters.size() > 0 and rng.randf() < 0.68:
				var cluster := clusters[rng.randi_range(0, clusters.size() - 1)]
				var angle := rng.randf_range(0.0, TAU)
